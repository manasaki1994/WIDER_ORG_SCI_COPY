{
  "type": "object",
  "properties": {
    "question": {"type": "string"},
    "target_description": {"type": "string", "description": "A paragraph describing the kind of study we are looking for: typical designs, actors, settings, outcomes."},
    "elements": {"type": "array", "minItems": 2, "maxItems": 6,
      "items": {"type": "object",
        "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "rule": {"type": "string"},
                       "counts": {"type": "array", "items": {"type": "string"}},
                       "does_not_count": {"type": "array", "items": {"type": "string"}}},
        "required": ["id", "name", "rule"]}},
    "exclusion_reasons": {"type": "array", "minItems": 1,
      "items": {"type": "object", "properties": {"code": {"type": "string"}, "text": {"type": "string"}, "element": {"type": "string"}},
                "required": ["code", "text"]}},
    "adjacent_literatures": {"type": "array",
      "items": {"type": "object",
        "properties": {"name": {"type": "string"}, "strains_element": {"type": "string"},
                       "decision": {"type": "string", "enum": ["exclude", "include", "maybe"]},
                       "reason_code": {"type": "string"}, "note": {"type": "string"}},
        "required": ["name", "strains_element", "decision"]}},
    "checks": {"type": "array",
      "items": {"type": "object",
        "properties": {"key": {"type": "string"}, "question": {"type": "string"}, "if_yes": {"type": "string"}},
        "required": ["key", "question", "if_yes"]}},
    "edge_cases": {"type": "array",
      "items": {"type": "object",
        "properties": {"key": {"type": "string"}, "case": {"type": "string"}, "default": {"type": "string"}},
        "required": ["key", "case", "default"]}},
    "labels": {"type": "array", "items": {"type": "object",
      "properties": {"group": {"type": "string"}, "values": {"type": "array", "items": {"type": "string"}}},
      "required": ["group", "values"]}},
    "thin_abstract_rule": {"type": "string"}
  },
  "required": ["question", "target_description", "elements", "exclusion_reasons"]
}
