{
  "type": "object",
  "properties": {
    "blocks": {"type": "array", "minItems": 1,
      "items": {"type": "object",
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "role": {"type": "string", "enum": ["required", "optional"]},
          "terms": {"type": "array", "minItems": 1,
            "items": {"anyOf": [
              {"type": "string", "minLength": 2},
              {"type": "object",
               "properties": {"near": {"type": "array", "minItems": 2,
                                        "items": {"anyOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}},
                              "distance": {"type": "integer", "minimum": 1, "maximum": 15},
                              "ordered": {"type": "boolean"}},
               "required": ["near"]}
            ]}},
          "fields": {"type": "array", "items": {"type": "string", "enum": ["title", "abstract", "keywords"]}}
        },
        "required": ["key", "name", "terms"]}},
    "logic": {},
    "notes": {"type": "string"}
  },
  "required": ["blocks", "logic"]
}
