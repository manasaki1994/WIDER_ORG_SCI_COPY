{
  "type": "object",
  "properties": {
    "construct": {"type": "string", "description": "One-sentence statement of the construct under review."},
    "dimensions": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {"type": "object",
        "properties": {"name": {"type": "string"}, "description": {"type": "string"},
                       "values": {"type": "array", "minItems": 2, "items": {"type": "object",
                         "properties": {"key": {"type": "string"}, "label": {"type": "string"}, "definition": {"type": "string"}},
                         "required": ["key", "label", "definition"]}}},
        "required": ["name", "values"]}
    },
    "cells": {
      "type": "array", "minItems": 1,
      "items": {"type": "object",
        "properties": {"key": {"type": "string"}, "labels": {"type": "object"},
                       "question": {"type": "string", "description": "What a study in this cell asks."},
                       "benchmark_ids": {"type": "array", "items": {"type": "string"}}},
        "required": ["key", "labels", "question"]}
    },
    "not_a_criterion": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["construct", "dimensions", "cells"]
}
